<?xml version="1.0" encoding="UTF-8"?>
<page xmlns="urn:coursekit:page" title="${page-label}" number-sections="false">

  <variables>
    <var name="page-label">The Course</var>
    <var name="module-label">Getting Started</var>
  </variables>

  <navbar page-title="${page-label}" module-title="${module-label}"/>

  <hero image="hero-sample.svg">
    <title>${course.title}</title>
    <subtitle>From design intent to playable systems</subtitle>
  </hero>

  <side position="before">
    <title>Course at a Glance</title>
    <facts>
      <fact label="Code" value="${course.code}"/>
      <fact label="Credits" value="3"/>
      <fact label="Session" value="${course.term} ${course.year}"/>
    </facts>
  </side>

  <central-content>
    <inline-toc/>

    <section id="section-1">
      <title>Section Title</title>
      <p>
        Paragraph text. You can include
        <hoverbox>
          <trigger>hoverable terms</trigger>
          <panel>
            <title>Definition</title>
            <p>Explanation text displayed on hover or tap. The underline belongs only to the trigger text, never to the following whitespace.</p>
          </panel>
        </hoverbox>
        inline in your prose.
      </p>

      <infobox variant="info" icon="info" style-ref="course-note">
        <title>Note</title>
        <p>Content of the info note.</p>
        <ul>
          <li>Lists use the infobox component's own spacing rules.</li>
          <li>The component keeps a consistent palette and icon treatment.</li>
        </ul>
      </infobox>

      <collapse-box>
        <title>Accordion title</title>
        <p>Content revealed when expanded.</p>
      </collapse-box>

      <section id="section-1-1" nav="false">
        <title>Subsection Title</title>
        <p>Subsections are nested structurally and receive their own heading level and spacing.</p>
      </section>
    </section>

    <section id="section-2">
      <title>Another Section</title>
      <p>More content here.</p>
      <picture-with-legend src="example-diagram.svg" alt="Simple example diagram" width="medium">
        <legend><p>Example of a responsive picture with a legend.</p></legend>
      </picture-with-legend>
      <picture-without-legend src="example-diagram.svg" alt="Same example diagram without a legend" width="small"/>
    </section>
  </central-content>

  <side position="after">
    <title>Useful Links</title>
    <links>
      <link href="#">Course Syllabus</link>
      <link href="#">Evaluation</link>
    </links>
  </side>

</page>
