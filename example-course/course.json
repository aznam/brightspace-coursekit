{
    "$schema": "../framework/schemas/course.schema.json",
    "version": 2,
    "siteId": null,
    "course": {
        "code": "COMP-XXXX",
        "title": "Course Name",
        "section": "01",
        "term": "Fall",
        "year": 2026
    },
    "modules": [
        "$(courseRoot)/modules/learning/module.json",
        "$(frameworkRoot)/modules/document/module.json",
        "$(frameworkRoot)/modules/fontawesome/module.json"
    ],
    "variables": {},
    "theme": {
        "palette": {
            "accent": "#c2410c",
            "accent-light": "#ffedd5",
            "structure": "#1e293b",
            "text-main": "#334155",
            "text-dark": "#0f172a",
            "border": "#e2e8f0",
            "bg-base": "#fafaf9",
            "surface": "#ffffff",
            "surface-muted": "#f8fafc"
        },
        "backgroundImage": null,
        "mode": "auto",
        "dark": {},
        "palettes": {
            "light": {},
            "dark": {}
        }
    },
    "customPaths": {
        "assets": "assets/",
        "attachments": "attachments/",
        "content": "content/",
        "styles": "styles/",
        "scripts": "scripts/",
        "fonts": "fonts/"
    },
    "resources": {
        "styles": [
            "$(courseRoot)/styles/course.css"
        ],
        "scripts": [
            "$(courseRoot)/scripts/behaviors.js"
        ],
        "fonts": [
            {
                "id": "body",
                "family": "Inter",
                "source": "online",
                "url": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap",
                "cssVariable": "--ck-font-body",
                "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
            },
            {
                "id": "display",
                "family": "Merriweather",
                "source": "online",
                "url": "https://fonts.googleapis.com/css2?family=Merriweather:wght@700;900&display=swap",
                "cssVariable": "--ck-font-display",
                "fallback": "Georgia, serif"
            }
        ]
    },
    "icons": {
        "info": {
            "type": "font",
            "classes": [
                "fa-solid",
                "fa-circle-info"
            ]
        },
        "warning": {
            "type": "font",
            "classes": [
                "fa-solid",
                "fa-triangle-exclamation"
            ]
        },
        "assignment-band.deadline-hard": {
            "type": "font",
            "classes": [
                "fa-solid",
                "fa-circle-exclamation"
            ]
        },
        "assignment-band.deadline-soft": {
            "type": "font",
            "classes": [
                "fa-solid",
                "fa-clock"
            ]
        },
        "assignment-band.submission-group": {
            "type": "font",
            "classes": [
                "fa-solid",
                "fa-users"
            ]
        },
        "assignment-band.submission-individual": {
            "type": "font",
            "classes": [
                "fa-solid",
                "fa-user"
            ]
        },
        "assignment-band.ai-restricted": {
            "type": "font",
            "classes": [
                "fa-solid",
                "fa-triangle-exclamation"
            ]
        },
        "assignment-band.ai-forbidden": {
            "type": "font",
            "classes": [
                "fa-solid",
                "fa-ban"
            ]
        },
        "assignment-band.estimated-time": {
            "type": "font",
            "classes": [
                "fa-solid",
                "fa-hourglass-half"
            ]
        },
        "assignment-band.expand": {
            "type": "font",
            "classes": [
                "fa-solid",
                "fa-chevron-down"
            ]
        },
        "assignment-band.difficulty-easy": {
            "type": "text",
            "value": "🟢"
        },
        "assignment-band.difficulty-medium": {
            "type": "text",
            "value": "🟡"
        },
        "assignment-band.difficulty-hard": {
            "type": "text",
            "value": "🔴"
        }
    },
    "learningOutcomes": [
        {
            "code": "LO1",
            "description": "Learning outcome 1"
        },
        {
            "code": "LO2",
            "description": "Learning outcome 2"
        },
        {
            "code": "LO3",
            "description": "Learning outcome 3"
        },
        {
            "code": "LO4",
            "description": "Learning outcome 4"
        },
        {
            "code": "LO5",
            "description": "Learning outcome 5"
        }
    ],
    "contentTable": "content-map.json"
}
