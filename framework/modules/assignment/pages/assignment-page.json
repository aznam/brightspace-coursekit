{
    "id": "assignment-page",
    "schema": "$(frameworkRoot)/modules/assignment/pages/assignment-page.xsd",
    "transform": "$(frameworkRoot)/modules/assignment/pages/assignment-page.xslt",
    "styles": [],
    "scripts": [
        "$(frameworkRoot)/modules/assignment/pages/assignment-page.js"
    ],
    "parameters": {
        "title": {
            "type": "string",
            "default": ""
        },
        "subtitle": {
            "type": "string",
            "default": ""
        },
        "module-name": {
            "type": "string",
            "default": ""
        },
        "image": {
            "type": "string",
            "default": ""
        },
        "background": {
            "type": "string",
            "default": "theme"
        },
        "toc": {
            "type": "boolean",
            "default": true
        },
        "page-numbered": {
            "type": "boolean",
            "default": false
        },
        "theme-switch": {
            "type": "boolean",
            "default": false
        },
        "variant": {
            "type": "string",
            "default": "default"
        },
        "style-ref": {
            "type": "string",
            "default": ""
        },
        "assignment-ref": {
            "type": "string",
            "default": ""
        }
    }
}
