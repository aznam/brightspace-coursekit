<?xml version='1.0' encoding='UTF-8'?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:p="urn:coursekit:page"
    xmlns:c="urn:coursekit:visual"
    xmlns:xsp="urn:coursekit:preprocessor"
    xmlns:mp="urn:coursekit:page:assignment"
    xmlns:ms="urn:coursekit:semantic:assignment"
    xmlns:mc="urn:coursekit:visual:assignment"
    targetNamespace="urn:coursekit:page:assignment"
    elementFormDefault="qualified">
  <xs:import namespace="urn:coursekit:visual:assignment"/>
  <xs:import namespace="urn:coursekit:page"/>
  <xs:element name="assignment-hero" type="mc:AssignmentHeroType"/>
  <xs:element name="assignment-band">
    <xs:complexType mixed="true">
      <xs:complexContent mixed="true">
        <xs:extension base="mc:AssignmentBandType">
          <xs:sequence>
            <xs:element ref="p:hoverbox" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="assignment-submit" type="mc:AssignmentSubmitType"/>
  <xs:element name="assignment-layout">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="mc:AssignmentLayoutType">
          <xs:sequence>
            <xs:element ref="p:navbar" minOccurs="0"/>
            <xs:element ref="mp:assignment-band"/>
            <xs:element ref="mp:assignment-hero" minOccurs="0"/>
            <xs:element ref="p:summary-box" minOccurs="0"/>
            <xs:element ref="p:sidebar-before" minOccurs="0"/>
            <xs:element ref="p:central-content"/>
            <xs:element ref="p:sidebar-after" minOccurs="0"/>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="AssignmentPageType">
    <xs:complexContent>
      <xs:extension base="p:PageType">
        <xs:sequence>
          <xs:element ref="mp:assignment-layout"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="assignment-page" type="mp:AssignmentPageType" substitutionGroup="p:page"/>
  <xsp:extend target="p:sidebar-before" slot="content">
    <xs:element ref="mp:assignment-submit"/>
  </xsp:extend>
</xs:schema>
