<?xml version='1.0' encoding='UTF-8'?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:p="urn:coursekit:page"
    xmlns:c="urn:coursekit:visual"
    xmlns:mp="urn:coursekit:page:document"
    xmlns:ms="urn:coursekit:semantic:document"
    xmlns:mc="urn:coursekit:visual:document"
    targetNamespace="urn:coursekit:page:document"
    elementFormDefault="qualified">
  <xs:import namespace="urn:coursekit:visual:document"/>
  <xs:import namespace="urn:coursekit:page"/>
  <xs:element name="document-layout">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="mc:DocumentLayoutType">
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element ref="mp:document-toolbar"/>
              <xs:element ref="mp:document-cover"/>
              <xs:element ref="mp:document-blank"/>
              <xs:element ref="mp:document-sheet"/>
              <xs:element ref="mp:document-flow"/>
              <xs:element ref="mp:document-end"/>
            </xs:choice>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="document-toolbar" type="mc:DocumentToolbarType"/>
  <xs:element name="document-cover">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="mc:DocumentCoverType">
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element ref="mp:document-cover-brand"/>
              <xs:element ref="mp:document-cover-title"/>
              <xs:element ref="mp:document-cover-meta"/>
            </xs:choice>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="document-cover-brand" type="mc:DocumentCoverBrandType"/>
  <xs:element name="document-cover-title" type="mc:DocumentCoverTitleType"/>
  <xs:element name="document-cover-meta" type="mc:DocumentCoverMetaType"/>
  <xs:element name="document-sheet">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="mc:DocumentSheetType">
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element ref="mp:document-page-frame"/>
            </xs:choice>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="document-page-frame">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="mc:DocumentPageFrameType">
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element ref="mp:document-header"/>
              <xs:element ref="mp:document-body"/>
              <xs:element ref="mp:document-footer"/>
            </xs:choice>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="document-header" type="mc:DocumentHeaderType"/>
  <xs:element name="document-footer" type="mc:DocumentFooterType"/>
  <xs:element name="document-body">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="mc:DocumentBodyType">
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element ref="mp:document-end"/>
            </xs:choice>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="document-flow">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="mc:DocumentFlowType">
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element ref="mp:document-section"/>
              <xs:element ref="mp:document-paragraph"/>
              <xs:element ref="mp:document-note"/>
              <xs:element ref="mp:document-list"/>
              <xs:element ref="mp:document-figure"/>
              <xs:element ref="mp:document-author"/>
              <xs:element ref="mp:document-break"/>
            </xs:choice>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="document-section">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="mc:DocumentSectionType">
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element ref="mp:document-paragraph"/>
              <xs:element ref="mp:document-note"/>
              <xs:element ref="mp:document-list"/>
              <xs:element ref="mp:document-figure"/>
              <xs:element ref="mp:document-author"/>
              <xs:element ref="mp:document-section"/>
              <xs:element ref="mp:document-break"/>
            </xs:choice>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="document-paragraph">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="mc:DocumentParagraphType"/>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="document-note">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="mc:DocumentNoteType">
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element ref="mp:document-paragraph"/>
              <xs:element ref="mp:document-list"/>
            </xs:choice>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="document-list">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="mc:DocumentListType">
          <xs:sequence>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element ref="p:item"/>
            </xs:choice>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element name="document-figure" type="mc:DocumentFigureType"/>
  <xs:element name="document-end" type="mc:DocumentEndType"/>
  <xs:element name="document-blank" type="mc:DocumentBlankType"/>
  <xs:element name="document-author" type="mc:DocumentAuthorType"/>
  <xs:element name="document-break" type="mc:DocumentBreakType"/>
  <xs:complexType name="DocumentPageType">
    <xs:complexContent>
      <xs:extension base="p:PageType">
        <xs:sequence>
          <xs:element ref="mp:document-layout"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="document-page" type="mp:DocumentPageType" substitutionGroup="p:page"/>
</xs:schema>
