<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:s="urn:coursekit:semantic"
           xmlns:d="urn:coursekit:semantic:document"
           targetNamespace="urn:coursekit:semantic:document"
           elementFormDefault="qualified">

    <xs:import namespace="urn:coursekit:semantic"/>

    <xs:complexType name="BreakType">
        <xs:attribute name="id" type="xs:ID"/>
    </xs:complexType>

    <xs:element name="break"
                type="d:BreakType"
                substitutionGroup="s:component"/>

</xs:schema>