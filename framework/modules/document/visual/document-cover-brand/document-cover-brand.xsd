<?xml version='1.0' encoding='UTF-8'?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:c="urn:coursekit:visual"
    xmlns:mp="urn:coursekit:page:document"
    xmlns:ms="urn:coursekit:semantic:document"
    xmlns:mc="urn:coursekit:visual:document"
    targetNamespace="urn:coursekit:visual:document"
    elementFormDefault="qualified">
  <xs:import namespace="urn:coursekit:visual"/>
  <xs:complexType name="DocumentCoverBrandType">
    <xs:complexContent>
      <xs:extension base="c:VisualNode">
        <xs:attribute name="logo" type="xs:string"/>
        <xs:attribute name="institution" type="xs:string"/>
        <xs:attribute name="faculty" type="xs:string"/>
        <xs:attribute name="department" type="xs:string"/>
        <xs:attribute name="code" type="xs:string"/>
        <xs:attribute name="course" type="xs:string"/>
        <xs:attribute name="program" type="xs:string"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>
