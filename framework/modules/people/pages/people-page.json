{
  "id": "people-page",
  "schema": "$(frameworkRoot)/modules/people/pages/people-page.xsd",
  "transform": "$(frameworkRoot)/modules/people/pages/people-page.xslt",
  "styles": [],
  "scripts": [],
  "parameters": {
    "title": {
      "type": "string",
      "default": ""
    },
    "subtitle": {
      "type": "string",
      "default": ""
    },
    "module-name": {
      "type": "string",
      "default": ""
    },
    "image": {
      "type": "string",
      "default": ""
    },
    "background": {
      "type": "string",
      "default": "theme"
    },
    "toc": {
      "type": "boolean",
      "default": true
    },
    "page-numbered": {
      "type": "boolean",
      "default": false
    },
    "theme-switch": {
        "type": "boolean",
        "default": false
    },
    "variant": {
      "type": "string",
      "default": "default"
    },
    "style-ref": {
      "type": "string",
      "default": ""
    }
    
  }
}
