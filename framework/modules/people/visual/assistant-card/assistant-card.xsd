<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:c="urn:coursekit:visual"
 targetNamespace="urn:coursekit:visual" elementFormDefault="qualified">
 <xs:include schemaLocation="$(frameworkRoot)/visual/base-component/base-component.xsd"/>
 <xs:complexType name="AssistantCardType">
  <xs:complexContent><xs:extension base="c:VisualContainer">
   <xs:attribute name="name" type="xs:string" use="required"/>
   <xs:attribute name="role" type="xs:string" use="required"/>
   <xs:attribute name="title" type="xs:string"/>
   <xs:attribute name="photo" type="xs:string"/>
   <xs:attribute name="email" type="xs:string"/>
   <xs:attribute name="booking-url" type="xs:anyURI"/>
   <xs:attribute name="online-hours" type="xs:string"/>
  </xs:extension></xs:complexContent>
 </xs:complexType>
</xs:schema>
