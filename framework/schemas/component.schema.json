{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CourseKit component manifest",
    "type": "object",
    "required": [
        "id",
        "template",
        "renderer"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "element": {
            "type": "string"
        },
        "abstract": {
            "type": "boolean"
        },
        "extends": {
            "type": "string"
        },
        "renderer": {
            "type": "string",
            "minLength": 1
        },
        "styles": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "scripts": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "template": {
            "type": "string",
            "minLength": 1
        },
        "schema": {
            "type": "string",
            "minLength": 1
        },
        "variants": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}
