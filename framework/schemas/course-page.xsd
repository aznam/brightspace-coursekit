<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="urn:coursekit:page" targetNamespace="urn:coursekit:page" elementFormDefault="qualified">
  <xs:group name="InlineElements">
    <xs:choice>
      <xs:element ref="strong" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="em" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="u" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="code" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="span" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="a" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="br" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="hoverbox" minOccurs="0" maxOccurs="1"/>
    </xs:choice>
  </xs:group>
  <xs:group name="FlowElements">
    <xs:choice>
      <xs:element ref="strong" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="em" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="u" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="code" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="span" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="a" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="br" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="hoverbox" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="p" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="ul" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="ol" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="pre" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="blockquote" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="dl" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="section" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="infobox" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="collapse-box" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="picture-with-legend" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="picture-without-legend" minOccurs="0" maxOccurs="1"/>
    </xs:choice>
  </xs:group>
  <xs:complexType name="strongType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="strong" type="strongType"/>
  <xs:complexType name="emType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="em" type="emType"/>
  <xs:complexType name="uType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="u" type="uType"/>
  <xs:complexType name="codeType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="code" type="codeType"/>
  <xs:complexType name="spanType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="role" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="span" type="spanType"/>
  <xs:complexType name="aType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="href" type="xs:string" use="required"/>
    <xs:attribute name="target" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="a" type="aType"/>
  <xs:complexType name="brType"/>
  <xs:element name="br" type="brType"/>
  <xs:complexType name="pType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="p" type="pType"/>
  <xs:complexType name="liType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="li" type="liType"/>
  <xs:complexType name="dtType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="dt" type="dtType"/>
  <xs:complexType name="ddType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="dd" type="ddType"/>
  <xs:complexType name="blockquoteType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="blockquote" type="blockquoteType"/>
  <xs:complexType name="ulType">
    <xs:sequence>
      <xs:element ref="li" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ul" type="ulType"/>
  <xs:complexType name="olType">
    <xs:sequence>
      <xs:element ref="li" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ol" type="olType"/>
  <xs:complexType name="dlType">
    <xs:sequence>
      <xs:sequence minOccurs="1" maxOccurs="unbounded">
        <xs:element ref="dt" minOccurs="1" maxOccurs="1"/>
        <xs:element ref="dd" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="dl" type="dlType"/>
  <xs:complexType name="preType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="pre" type="preType"/>
  <xs:complexType name="titleType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="title" type="titleType"/>
  <xs:complexType name="subtitleType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="subtitle" type="subtitleType"/>
  <xs:complexType name="triggerType" mixed="true">
    <xs:group ref="InlineElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="trigger" type="triggerType"/>
  <xs:complexType name="panelType" mixed="true">
    <xs:sequence>
      <xs:element ref="title" minOccurs="0" maxOccurs="1"/>
      <xs:group ref="FlowElements" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="panel" type="panelType"/>
  <xs:complexType name="hoverboxType">
    <xs:sequence>
      <xs:element ref="trigger" minOccurs="1" maxOccurs="1"/>
      <xs:element ref="panel" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="style-ref" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="hoverbox" type="hoverboxType"/>
  <xs:complexType name="varType" mixed="true">
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:element name="var" type="varType"/>
  <xs:complexType name="variablesType">
    <xs:sequence>
      <xs:element ref="var" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="variables" type="variablesType"/>
  <xs:complexType name="navbarType">
    <xs:attribute name="course-code" type="xs:string" use="optional"/>
    <xs:attribute name="page-title" type="xs:string" use="optional"/>
    <xs:attribute name="module-title" type="xs:string" use="optional"/>
    <xs:attribute name="navigate-label" type="xs:string" use="optional"/>
    <xs:attribute name="style-ref" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="navbar" type="navbarType"/>
  <xs:complexType name="heroType">
    <xs:sequence>
      <xs:element ref="title" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="subtitle" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="image" type="xs:string" use="optional"/>
    <xs:attribute name="style-ref" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="hero" type="heroType"/>
  <xs:complexType name="inlineTocType">
    <xs:attribute name="aria-label" type="xs:string" use="optional"/>
    <xs:attribute name="label" type="xs:string" use="optional"/>
    <xs:attribute name="style-ref" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="inline-toc" type="inlineTocType"/>
  <xs:complexType name="factType" mixed="true">
    <xs:attribute name="label" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="fact" type="factType"/>
  <xs:complexType name="factsType">
    <xs:sequence>
      <xs:element ref="fact" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="facts" type="factsType"/>
  <xs:complexType name="linkType" mixed="true">
    <xs:attribute name="href" type="xs:string" use="required"/>
    <xs:attribute name="target" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="link" type="linkType"/>
  <xs:complexType name="linksType">
    <xs:sequence>
      <xs:element ref="link" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="links" type="linksType"/>
  <xs:complexType name="sideType">
    <xs:sequence>
      <xs:element ref="title" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="facts" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="links" minOccurs="0" maxOccurs="1"/>
      <xs:group ref="FlowElements" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="position" type="xs:string" use="optional"/>
    <xs:attribute name="style-ref" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="side" type="sideType"/>
  <xs:complexType name="sectionType">
    <xs:sequence>
      <xs:element ref="title" minOccurs="0" maxOccurs="1"/>
      <xs:group ref="FlowElements" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="optional"/>
    <xs:attribute name="nav" type="xs:boolean" use="optional"/>
    <xs:attribute name="nav-label" type="xs:string" use="optional"/>
    <xs:attribute name="style-ref" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="section" type="sectionType"/>
  <xs:complexType name="infoboxType">
    <xs:sequence>
      <xs:element ref="title" minOccurs="0" maxOccurs="1"/>
      <xs:group ref="FlowElements" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="variant" type="xs:string" use="optional"/>
    <xs:attribute name="icon" type="xs:string" use="optional"/>
    <xs:attribute name="style-ref" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="infobox" type="infoboxType"/>
  <xs:complexType name="collapseBoxType">
    <xs:sequence>
      <xs:element ref="title" minOccurs="0" maxOccurs="1"/>
      <xs:group ref="FlowElements" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="title" type="xs:string" use="optional"/>
    <xs:attribute name="open" type="xs:boolean" use="optional"/>
    <xs:attribute name="style-ref" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="collapse-box" type="collapseBoxType"/>
  <xs:complexType name="legendType" mixed="true">
    <xs:group ref="FlowElements" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:element name="legend" type="legendType"/>
  <xs:complexType name="pictureLegendType">
    <xs:sequence>
      <xs:element ref="legend" minOccurs="1" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="src" type="xs:string" use="required"/>
    <xs:attribute name="alt" type="xs:string" use="optional"/>
    <xs:attribute name="width" type="xs:string" use="optional"/>
    <xs:attribute name="loading" type="xs:string" use="optional"/>
    <xs:attribute name="style-ref" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="picture-with-legend" type="pictureLegendType"/>
  <xs:complexType name="picturePlainType">
    <xs:attribute name="src" type="xs:string" use="required"/>
    <xs:attribute name="alt" type="xs:string" use="optional"/>
    <xs:attribute name="width" type="xs:string" use="optional"/>
    <xs:attribute name="loading" type="xs:string" use="optional"/>
    <xs:attribute name="style-ref" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="picture-without-legend" type="picturePlainType"/>
  <xs:complexType name="centralContentType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="inline-toc" minOccurs="0" maxOccurs="1"/>
        <xs:element ref="section" minOccurs="0" maxOccurs="1"/>
        <xs:element ref="p" minOccurs="0" maxOccurs="1"/>
        <xs:element ref="ul" minOccurs="0" maxOccurs="1"/>
        <xs:element ref="ol" minOccurs="0" maxOccurs="1"/>
        <xs:element ref="pre" minOccurs="0" maxOccurs="1"/>
        <xs:element ref="blockquote" minOccurs="0" maxOccurs="1"/>
        <xs:element ref="dl" minOccurs="0" maxOccurs="1"/>
        <xs:element ref="infobox" minOccurs="0" maxOccurs="1"/>
        <xs:element ref="collapse-box" minOccurs="0" maxOccurs="1"/>
        <xs:element ref="picture-with-legend" minOccurs="0" maxOccurs="1"/>
        <xs:element ref="picture-without-legend" minOccurs="0" maxOccurs="1"/>
      </xs:choice>
    </xs:sequence>
    <xs:attribute name="style-ref" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="central-content" type="centralContentType"/>
  <xs:complexType name="pageType">
    <xs:sequence>
      <xs:element ref="variables" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="navbar" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="hero" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="side" minOccurs="0" maxOccurs="1"/>
      <xs:element ref="central-content" minOccurs="1" maxOccurs="1"/>
      <xs:element ref="side" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
    <xs:attribute name="title" type="xs:string" use="optional"/>
    <xs:attribute name="number-sections" type="xs:boolean" use="optional"/>
    <xs:attribute name="background" type="xs:string" use="optional"/>
  </xs:complexType>
  <xs:element name="page" type="pageType"/>
</xs:schema>
