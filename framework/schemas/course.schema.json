                    ]
                },
                "schemas": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "resources": {
            "type": "object",
            "properties": {
                "styles": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "scripts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "fonts": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "id",
                            "family",
                            "source"
                        ],
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "family": {
                                "type": "string"
                            },
                            "source": {
                                "enum": [
                                    "online",
                                    "local"
                                ]
                            },
                            "url": {
                                "type": "string"
                            },
                            "location": {
                                "enum": [
                                    "course",
                                    "framework"
                                ]
                            },
                            "cssVariable": {
                                "type": "string"
                            },
                            "fallback": {
                                "type": "string"
                            },
                            "files": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "file"
                                    ],
                                    "properties": {
                                        "file": {
                                            "type": "string"
                                        },
                                        "format": {
                                            "type": "string"
                                        },
                                        "weight": {
                                            "type": [
                                                "integer",
                                                "string"
                                            ]
                                        },
                                        "style": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "icons": {
            "type": "object",
            "description": "Site overrides for logical icon identifiers. Scoped keys such as infobox.warning take precedence over warning.",
            "additionalProperties": {
                "oneOf": [
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "type",
                            "value"
                        ],
                        "properties": {
                            "type": {
                                "const": "text"
                            },
                            "value": {
                                "type": "string"
                            }
                        }
                    },
                    {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "type",
                            "classes"
                        ],
                        "properties": {
                            "type": {
                                "const": "font"
                            },
                            "classes": {
                                "type": "array",
                                "minItems": 1,
                                "uniqueItems": true,
                                "items": {
                                    "type": "string",
                                    "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                                }
                            }
                        }
                    }
                ]
            }
