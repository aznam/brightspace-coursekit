{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CourseKit module manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "namespace"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "manifest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "manifest": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "pages": {
      "type": "array",
      "maxItems": 0,
      "description": "Reserved for a future page extension system; course modules currently only add components."
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reserved for future module dependencies; unsupported at runtime."
    }
  }
}
