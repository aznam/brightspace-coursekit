{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CourseKit semantic manifest",
    "type": "object",
    "required": [
        "id",
        "schema"
    ],
    "properties": {
        "id": {
            "type": "string",
            "minLength": 1
        },
        "schema": {
            "type": "string",
            "minLength": 1
        },
        "namespace": {
            "type": "string"
        },
        "name": {
            "type": "string"
        }
    },
    "additionalProperties": true
}
