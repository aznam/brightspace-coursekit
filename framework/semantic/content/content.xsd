<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:s="urn:coursekit:semantic" targetNamespace="urn:coursekit:semantic" elementFormDefault="qualified">
    
    <xs:include schemaLocation="$(frameworkRoot)/semantic/core/core.xsd"/>

    <xs:element name="content">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="s:component" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="page-type" type="xs:string" use="required"/>
            <xs:attribute name="page-short-title" type="xs:string" use="optional"/>
            <xs:attribute name="desc" type="xs:string" use="optional"/>
            <xs:attribute name="hook-title" type="xs:string" use="optional"/>
            <xs:anyAttribute processContents="lax"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
