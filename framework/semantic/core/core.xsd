<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:s="urn:coursekit:semantic" targetNamespace="urn:coursekit:semantic" elementFormDefault="qualified">
    
    <xs:element name="component" type="xs:anyType" abstract="true"/>

    <xs:attributeGroup name="CommonAttr">
        <xs:attribute name="id" type="xs:ID"/>
        <xs:attribute name="title" type="xs:string"/>
    </xs:attributeGroup>

    <xs:complexType name="Container">
        <xs:attributeGroup ref="s:CommonAttr"/>
        <xs:attribute name="nav" type="xs:boolean"/>
    </xs:complexType>

    <xs:complexType name="Text" mixed="true">
        <xs:attributeGroup ref="s:CommonAttr"/>
    </xs:complexType>
    
</xs:schema>