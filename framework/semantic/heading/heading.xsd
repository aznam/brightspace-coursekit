<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:s="urn:coursekit:semantic" targetNamespace="urn:coursekit:semantic" elementFormDefault="qualified">
    
    <xs:include schemaLocation="$(frameworkRoot)/semantic/core/core.xsd"/>
    <xs:include schemaLocation="$(frameworkRoot)/semantic/link/link.xsd"/>

    <xs:include schemaLocation="$(frameworkRoot)/semantic/inline/inline.xsd"/>

    <xs:complexType name="HeadingType">
        <xs:complexContent mixed="true">
            <xs:extension base="s:Text">
                <xs:choice minOccurs="0" maxOccurs="unbounded">
                    <xs:element ref="s:link"/>
                    <xs:group ref="s:InlineEmphasis"/>
                </xs:choice>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:element name="heading" type="s:HeadingType" substitutionGroup="s:component"/>

</xs:schema>
