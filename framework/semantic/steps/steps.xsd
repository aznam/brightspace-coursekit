<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:s="urn:coursekit:semantic" targetNamespace="urn:coursekit:semantic" elementFormDefault="qualified">
    <xs:include schemaLocation="$(frameworkRoot)/semantic/core/core.xsd"/>
    <xs:include schemaLocation="$(frameworkRoot)/semantic/item/item.xsd"/>
    <xs:complexType name="StepsType">
        <xs:complexContent><xs:extension base="s:Container">
            <xs:sequence><xs:element ref="s:item" minOccurs="1" maxOccurs="unbounded"/></xs:sequence>
        </xs:extension></xs:complexContent>
    </xs:complexType>
    <xs:element name="steps" type="s:StepsType" substitutionGroup="s:component"/>
</xs:schema>
