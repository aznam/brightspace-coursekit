<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:c="urn:coursekit:visual" targetNamespace="urn:coursekit:visual" elementFormDefault="qualified">
    
    <xs:include schemaLocation="$(frameworkRoot)/visual/base-component/base-component.xsd"/>
    
    <xs:complexType name="NavbarType">
        <xs:complexContent>
            <xs:extension base="c:VisualContainer">
                <xs:attribute name="course-code" type="xs:string"/>
                <xs:attribute name="page-title" type="xs:string"/>
                <xs:attribute name="module-title" type="xs:string"/>
                <xs:attribute name="navigate-label" type="xs:string"/>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

</xs:schema>
