<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:c="urn:coursekit:visual" targetNamespace="urn:coursekit:visual" elementFormDefault="qualified">
    <xs:include schemaLocation="$(frameworkRoot)/visual/base-component/base-component.xsd"/>
    <xs:complexType name="LayoutType">
        <xs:complexContent>
            <xs:extension base="c:VisualContainer">
                <xs:attribute name="title" type="xs:string"/>
                <xs:attribute name="subtitle" type="xs:string"/>
                <xs:attribute name="image" type="xs:string"/>
                <xs:attribute name="background" type="xs:string"/>
                <xs:attribute name="page-numbered" type="xs:boolean"/>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
</xs:schema>
