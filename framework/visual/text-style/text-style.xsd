<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:c="urn:coursekit:visual"
           targetNamespace="urn:coursekit:visual"
           elementFormDefault="qualified">
    <xs:include schemaLocation="$(frameworkRoot)/visual/base-component/base-component.xsd"/>
    <xs:complexType name="TextStyleType" mixed="true">
        <xs:complexContent mixed="true">
            <xs:extension base="c:VisualNode">
                <xs:attribute name="kind" use="required">
                    <xs:simpleType><xs:restriction base="xs:string">
                        <xs:enumeration value="important"/>
                        <xs:enumeration value="emphase"/>
                        <xs:enumeration value="underline"/>
                    </xs:restriction></xs:simpleType>
                </xs:attribute>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>
</xs:schema>
