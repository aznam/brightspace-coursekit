{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "courses"
    ],
    "additionalProperties": false,
    "properties": {
        "courses": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "root"
                ],
                "additionalProperties": false,
                "properties": {
                    "root": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        }
    }
}
