{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "id",
        "name",
        "entry",
        "category"
    ],
    "additionalProperties": false,
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string"
        },
        "entry": {
            "type": "string",
            "minLength": 1
        },
        "category": {
            "enum": [
                "local",
                "deployed"
            ]
        },
        "version": {
            "type": "string"
        }
    }
}
